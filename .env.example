### Django
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_LOG_LEVEL=INFO
TRUSTED_PROXY_COUNT=0

### PostgreSQL
POSTGRES_DB=ragmanager
POSTGRES_USER=ragmanager
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

### Redis
REDIS_URL=redis://redis:6379/0

### Qdrant
QDRANT_URL=https://qdrant.example.com:443
QDRANT_API_KEY=

### Object storage
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ragmanager
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

### MinIO service credentials
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

### Published host ports
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

### Public hostname behind a reverse proxy
PUBLIC_HOST=

### Cache (throttling)
CACHE_URL=redis://redis:6379/1

### Uploads
MAX_UPLOAD_BYTES=536870912

### Embeddings through an API (optional; local model needs no key).
### EMBEDDING_API_KEY is the shared fallback. To give one collection its own
### credential, set EMBEDDING_API_KEY_<NAME>, upper cased with hyphens turned
### into underscores: a collection named openai-large reads
### EMBEDDING_API_KEY_OPENAI_LARGE.
EMBEDDING_API_KEY=

### Reading files with no text layer
### Local OCR is used by default and needs nothing configured.
### Point these at any OpenAI compatible chat endpoint to use a vision model instead.
OCR_LANGUAGES=eng
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

### How text is split before it is embedded.
### Every model reads only so many tokens of a chunk and ignores the rest, so a
### chunk longer than the model reads is stored in full while only its opening
### influenced the vector. The default model here reads about 200 words.
### A collection may override both of these with its own size.
CHUNK_WORDS=200
CHUNK_OVERLAP_WORDS=40

### Ingestion budget, so one unreadable scan cannot hold the worker forever
INGESTION_SOFT_TIME_LIMIT_SECONDS=900
INGESTION_TIME_LIMIT_SECONDS=960

### Retrying a run that failed because a dependency was unreachable.
### A failure caused by the file itself is never retried.
INGESTION_MAX_RETRIES=5
INGESTION_RETRY_BACKOFF_SECONDS=30
INGESTION_RETRY_MAX_BACKOFF_SECONDS=900

### How long a page of a listing is, and the most a caller may ask for
PAGE_SIZE=100
MAX_PAGE_SIZE=500

### How often one agent may call the search endpoint
SEARCH_THROTTLE_RATE=60/min

### Frontend build stage: production serves a static build, development runs Vite
FRONTEND_TARGET=production

### Set to true only to accept development settings on a public hostname
ALLOW_PUBLIC_DEBUG=
